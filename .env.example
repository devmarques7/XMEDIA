# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Sem estas variáveis a app corre em "modo local" (dados só no navegador).

# Servidor (Vercel). A integração Supabase cria a service role automaticamente.
SUPABASE_SERVICE_ROLE_KEY=
# Assinatura das sessões dos funcionários (login por código). Opcional: usa a service role se vazio.
MEMBER_SESSION_SECRET=
# Envio de convites por email (https://resend.com). Sem chave, a app mostra o link para partilhar.
RESEND_API_KEY=
INVITE_FROM="XMEDIA <equipa@seudominio.com>"

# Assistente (Claude) — chave da API em https://platform.claude.com (só no servidor)
ANTHROPIC_API_KEY=
# Em modo local (sem Supabase), código pedido no painel do assistente. Com Supabase, só o admin autenticado acede.
AI_ACCESS_CODE=

# Emails com acesso de administrador (Google). Vazio = qualquer conta Google pode registar-se.
ADMIN_EMAILS=

# Servidor MCP (/api/mcp) — token longo e aleatório; o Claude Code envia-o em "Authorization: Bearer …"
MCP_TOKEN=
# Dono dos dados acedidos pelo MCP (o seu email do Google). Por omissão usa o primeiro de ADMIN_EMAILS.
MCP_OWNER_EMAIL=

# Portal do cliente → Instagram (Meta for Developers → app → Instagram → "API setup with Instagram login").
# Redirect URI a registar na app Meta: https://<domínio>/api/portal/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional: versão da Graph API (por omissão v25.0)
INSTAGRAM_GRAPH_VERSION=
# Publicação automática: o agendador chama GET /api/cron/publish com "Authorization: Bearer $CRON_SECRET" a cada 5–15 min
CRON_SECRET=
